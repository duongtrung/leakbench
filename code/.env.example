# LeakBench credentials --- copy to `.env` and fill in. `.env` is gitignored.
#
# Only the LLM-backed paths read these: the neural planner for RQ8
# (scripts/run_live_capture.py --planner llm) and the LLM-driven framework adapters
# (scripts/run_adapter.py). The generator, the measured harness, and the default
# loopback live capture never touch the network.
#
# Key names are matched case-insensitively, so OpenRouter_API_KEY also works.

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# https://console.groq.com/keys
GROQ_API_KEY=

# Optional: any other OpenAI-compatible endpoint (used with --llm-provider custom)
# LLM_API_KEY=
# LLM_BASE_URL=https://your-endpoint/v1
